def main():
    if len(sys.argv) < 2:
        show_help()
        return

    cmd = sys.argv[1]
    args = sys.argv[1:]

    commands = {
        'show': cmd_show,
        'save': cmd_save,
        'search': cmd_search,
        'stats': cmd_stats,
        'status': cmd_status,
        'topics': cmd_topics,
        'help': show_help,
        '--help': show_help,
        '-h': show_help
    }

    if cmd in commands:
        commands[cmd](args)
    else:
        print(f"Unknown command: {cmd}")
        print("Run 'uni-mem help' for usage")


if __name__ == "__main__":
    main()

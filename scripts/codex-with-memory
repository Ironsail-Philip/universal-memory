#!/bin/bash
# Codex CLI Wrapper with Memory
# Loads unified memory before starting Codex
# Uses session-based tracking (not time-based suppression)

OUTPUT=""
if OUTPUT=$(python3 ~/.universal-memory/hooks/load-memory.py \
    --source all \
    --limit 20 \
    --session-key codex 2>&1); then
    if [ -n "$OUTPUT" ]; then
        echo ""
        echo "🧠 Loading Universal AI Memory (RAG System)..."
        echo ""
        printf '%s\n' "$OUTPUT"
        echo ""
    fi
else
    echo ""
    echo "⚠️  Universal Memory failed to load."
    echo ""
fi

echo ""
echo "Starting Codex..."
echo ""

# Run codex with all arguments passed through, bypassing aliases
command codex "$@"
